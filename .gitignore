# OS
.DS_Store
Thumbs.db

# Project-specific: large geospatial data, not committed raw
backend/data/srtm_tiles/*.tif
backend/data/srtm_tiles/*.tiff
!backend/data/srtm_tiles/.gitkeep
!backend/data/srtm_tiles/regions.json
*.geotiff

# GAMUS dataset cache & HDF5 files (never commit)
backend/data/gamus_cache/
*.h5
*.hdf5

# Model weights: pulled via scripts/download_weights.py; commit only the lockfile
models/*
!models/pinned_revisions.json

# Append-only accuracy log. Unit tests and mock-depth wiring runs write here
# by default; do not commit those rows. Real DA-V2 / SRTM numbers belong in
# an untracked local copy (or DEPTHWIZARD_ACCURACY_LOG) with an explicit
# model_id of depth-anything-v2-small — never treat mock R² as judge metrics.
docs/accuracy_log.jsonl

# Generated pipeline outputs and local test images
outputs/

# Ignore loose sample directories from ad-hoc test runs, but not the curated
# backend/data/samples/ directory (which has its own rules below).
/samples/

# backend/data/samples/: track the manifest, docs, and the three demo GeoTIFFs.
backend/data/samples/*
!backend/data/samples/.gitkeep
!backend/data/samples/samples.json
!backend/data/samples/README.md
!backend/data/samples/delhi_urban.tif
!backend/data/samples/mussoorie_hilly.tif
!backend/data/samples/chennai_coastal.tif
!backend/data/samples/cached/
!backend/data/samples/cached/**

# Local eval test pairs (image + reference DEM copies for run_eval.py)
eval_pairs/
